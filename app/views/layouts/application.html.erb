<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Barômetro Gaúcho" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Barômetro Gaúcho">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <% relative_root = Rails.application.config.relative_url_root.to_s.chomp("/") %>
    <link rel="icon" href="<%= "#{relative_root}/icon.png" %>" type="image/png">
    <link rel="icon" href="<%= "#{relative_root}/icon.svg" %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= "#{relative_root}/icon.png" %>">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <%= javascript_include_tag "chartkick", "data-turbo-track": "reload" %>
    <script>
      if (window.Chartkick && window.Chart) {
        Chartkick.use(Chart);
      }
    </script>
  </head>

  <body class="bg-slate-100 text-slate-900">
    <main class="container mx-auto max-w-6xl px-4 py-8">
      <%= yield %>
    </main>
  </body>
</html>
