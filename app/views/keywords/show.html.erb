<% content_for :title, @keyword.term %>

<div class="space-y-6">
  <%= link_to "← Voltar", root_path, class: "text-sm font-medium text-blue-700 hover:underline" %>

  <header class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h1 class="text-2xl font-bold"><%= display_keyword_term(@keyword.term) %></h1>
        <% if @snapshot&.is_critical? %>
          <p class="mt-2 inline-flex rounded-full bg-rose-600 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">Ponto crítico</p>
        <% end %>
        <p class="mt-3 text-sm text-slate-600">Humor 0 = positivo · 50 = neutro · 100 = negativo</p>
        <p class="mt-2 text-sm text-slate-600">
          <strong>Relevância</strong> (0–100) ranqueia destaque no painel (recência, palavra no título,
          cruzamento de fontes e tom negativo). Não substitui o humor — mede urgência, não o sentimento.
        </p>
        <p class="mt-2 text-sm text-slate-600">
          <strong>Institucional</strong> e <strong>Temático</strong> são lentes separadas: a primeira
          olha o governo/Estado; a segunda, o tema. Podem divergir (ex.: institucional positivo e
          temático negativo); o humor da matéria é a média das duas.
        </p>
      </div>
      <% if @analyses.any? %>
        <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
          <p><span class="font-semibold"><%= @analyses.size %></span> matérias neste ciclo</p>
          <p class="mt-1">Mediana do humor: <span class="font-semibold"><%= number_with_precision(@median_humor, precision: 1) %></span>/100</p>
          <% if @snapshot %>
            <% neg_band = [ 100.0 - @snapshot.pct_positive.to_f - @snapshot.pct_neutral.to_f, 0 ].max.round(0) %>
            <p class="mt-1 text-xs text-slate-500">
              Distribuição: <%= number_with_precision(@snapshot.pct_positive, precision: 0) %>% pos ·
              <%= number_with_precision(@snapshot.pct_neutral, precision: 0) %>% neu ·
              <%= neg_band %>% neg
            </p>
          <% end %>
        </div>
      <% end %>
    </div>
  </header>

  <%= render "shared/metrics_reference" %>

  <section class="space-y-4">
    <% if @analyses.any? %>
      <% @analyses.each do |analysis| %>
        <% humor = HumorScore.call(analysis) %>
        <article class="rounded-xl border <%= humor >= 70 ? 'border-rose-300 bg-rose-50' : (humor <= 30 ? 'border-emerald-300 bg-emerald-50' : 'border-slate-200 bg-white') %> p-5 shadow-sm">
          <div class="mb-3 flex flex-wrap items-center gap-2">
            <%= humor_badge(humor) %>
            <%= relevance_badge(analysis.relevance_score) %>
            <%= sentiment_badge("Institucional", analysis.sentiment_institutional) %>
            <%= sentiment_badge("Temático", analysis.sentiment_thematic) %>
          </div>

          <div class="mb-4">
            <div class="mb-1 flex justify-between text-xs text-slate-500">
              <span>Positivo</span>
              <span>Negativo</span>
            </div>
            <div class="h-2 overflow-hidden rounded-full bg-gradient-to-r from-emerald-200 via-amber-200 to-rose-200">
              <div class="relative h-full">
                <span class="absolute top-1/2 h-3 w-3 -translate-y-1/2 rounded-full border-2 border-white bg-slate-900 shadow" style="left: calc(<%= humor %>% - 6px)"></span>
              </div>
            </div>
          </div>

          <h2 class="text-lg font-semibold"><%= analysis.article.title %></h2>
          <p class="mt-1 text-sm text-slate-500"><%= analysis.article.source.name %><% if analysis.article.published_at %> · <%= l(analysis.article.published_at, format: :short) rescue analysis.article.published_at.strftime("%d/%m/%Y %H:%M") %><% end %></p>
          <p class="mt-3 text-slate-700"><%= analysis.article.plain_snippet %></p>
          <%= link_to "Ler matéria original", analysis.article.url, target: "_blank", rel: "noopener", class: "mt-4 inline-block text-sm font-medium text-blue-700 hover:underline" %>
        </article>
      <% end %>
    <% else %>
      <p class="text-slate-500">Nenhuma matéria encontrada para este tema no ciclo atual.</p>
    <% end %>
  </section>
</div>
