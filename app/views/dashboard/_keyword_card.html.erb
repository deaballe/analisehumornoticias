<% if snapshot.article_count.zero? %>
  <div class="rounded-xl border p-4 shadow-sm <%= snapshot_status_class(snapshot) %>">
    <h3 class="font-semibold"><%= display_keyword_term(snapshot.keyword.term) %></h3>
    <p class="mt-3 text-sm text-slate-500">Nenhuma matéria encontrada para este tema no ciclo atual.</p>
  </div>
<% else %>
  <%= link_to keyword_path(snapshot.keyword), class: "block rounded-xl border p-4 shadow-sm transition hover:shadow-md #{snapshot_status_class(snapshot)}" do %>
    <div class="mb-3 flex items-start justify-between gap-3">
      <h3 class="font-semibold"><%= display_keyword_term(snapshot.keyword.term) %></h3>
      <% if snapshot.is_critical? %>
        <span class="rounded-full bg-rose-600 px-2 py-1 text-xs font-semibold uppercase tracking-wide text-white">Atenção</span>
      <% end %>
    </div>

    <% neg_band = [ 100.0 - snapshot.pct_positive.to_f - snapshot.pct_neutral.to_f, 0 ].max.round(0) %>
    <p class="text-sm text-slate-700">
      Mediana do humor <span class="font-semibold"><%= number_with_precision(snapshot.pct_negative, precision: 0) %></span>/100
      · <%= snapshot.article_count %> matérias
    </p>
    <p class="mt-1 text-sm text-slate-700">
      Mediana da relevância <span class="font-semibold"><%= number_with_precision(snapshot.median_relevance, precision: 0) %></span>/100
    </p>
    <div class="mt-3 flex flex-wrap gap-2 text-xs">
      <span class="rounded bg-emerald-100 px-2 py-1 text-emerald-800"><%= number_with_precision(snapshot.pct_positive, precision: 0) %>% pos</span>
      <span class="rounded bg-amber-100 px-2 py-1 text-amber-800"><%= number_with_precision(snapshot.pct_neutral, precision: 0) %>% neu</span>
      <span class="rounded bg-rose-100 px-2 py-1 text-rose-800"><%= neg_band %>% neg</span>
    </div>
  <% end %>
<% end %>
